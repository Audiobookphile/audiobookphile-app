

// Default values to prevent Xcode Cloud from crashing during initial build graph resolution
// These will be overridden by Skip.env once ci_post_clone.sh executes.
PRODUCT_NAME = Audiobookphile
PRODUCT_BUNDLE_IDENTIFIER = club.foodshare.audiobookphile
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

#include? "../Skip.env"

// Set the action that will be executed as part of the Xcode Run Script phase
// Setting to "launch" will build and run the app in the first open Android emulator or device
// Setting to "build" will just run gradle build, but will not launch the app
// Setting to "none" will completely disable the build and launch of the Android app
SKIP_ACTION = none
//SKIP_ACTION = build
//SKIP_ACTION = launch

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

INFOPLIST_FILE = Info.plist
GENERATE_INFOPLIST_FILE = YES

// The user-visible name of the app (localizable)
INFOPLIST_KEY_CFBundleDisplayName = Audiobookphile
//INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities

// iOS-specific Info.plist property keys
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphone*] = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphone*] = YES
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphone*] = YES
INFOPLIST_KEY_UIStatusBarStyle[sdk=iphone*] = UIStatusBarStyleDefault
INFOPLIST_KEY_UISupportedInterfaceOrientations[sdk=iphone*] = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
SUPPORTS_MACCATALYST = NO

SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx

// iPhone + iPad
TARGETED_DEVICE_FAMILY = 1,2

// iPhone only
// TARGETED_DEVICE_FAMILY = 1

// the name of the product module; this can be anything, but cannot conflict with any Swift module names
PRODUCT_MODULE_NAME = $(PRODUCT_NAME:c99extidentifier)App

// On-device testing may need to override the bundle ID
// PRODUCT_BUNDLE_IDENTIFIER[config=Debug][sdk=iphoneos*] = cool.beans.BundleIdentifer

SDKROOT = auto

SWIFT_VERSION = 6

// Development team ID for on-device testing
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Entitlements.plist

// Disable code signing for macOS targets (e.g. Swift Macros) to prevent Xcode Cloud from crashing
CODE_SIGNING_REQUIRED[sdk=macosx*] = NO
CODE_SIGNING_ALLOWED[sdk=macosx*] = NO
// Xcode Cloud automatic signing manages the development team.

INFOPLIST_KEY_ServerURL = $(API_SERVER_URL)
INFOPLIST_KEY_SupabaseURL = $(NEXT_PUBLIC_SUPABASE_URL)
INFOPLIST_KEY_SupabaseAnonKey = $(NEXT_PUBLIC_SUPABASE_ANON_KEY)
INFOPLIST_KEY_SentryDSN = $(SENTRY_DSN)

// SKIP_INSTALL = YES is the correct default for the xcconfig base.
// The app target overrides this to NO at the pbxproj target level (both Debug and Release).
// SPM dynamic framework targets (e.g. Audiobookphile.framework) inherit YES from here,
// which prevents them from being installed as top-level archive products.
// Without this, Xcode creates a "Generic Archive" that cannot be exported (exit code 70).
SKIP_INSTALL = YES
